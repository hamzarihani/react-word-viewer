{
  "name": "react-word-viewer",
  "version": "1.0.0",
  "description": "High-performance React component for viewing, navigating, and interacting with Word (.docx, .doc) documents in the browser with zero server dependencies.",
  "keywords": [
    "react",
    "word",
    "viewer",
    "docx",
    "docx-viewer",
    "doc-viewer",
    "react-component",
    "document-viewer",
    "react-word-viewer",
    "docx-preview"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamzarihani/react-word-viewer.git"
  },
  "homepage": "https://github.com/hamzarihani/react-word-viewer#readme",
  "bugs": {
    "url": "https://github.com/hamzarihani/react-word-viewer/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && tsc --emitDeclarationOnly",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
